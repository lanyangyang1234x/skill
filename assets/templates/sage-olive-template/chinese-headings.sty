\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{chinese-headings}[2026/10/26 Chinese-only serif heading profile]
\RequirePackage{portable-math-fonts}
% Opt in explicitly. The English/default path preserves the shared font style.
\newif\ifChineseHeadingProfile
\DeclareOption{chinese}{\ChineseHeadingProfiletrue}
\DeclareOption{english}{\ChineseHeadingProfilefalse}
\ExecuteOptions{english}
\ProcessOptions\relax
\makeatletter
\let\CHOriginalTheoremHead\thmhead@plain
\makeatother

\ifChineseHeadingProfile
\setCJKfamilyfont{zhheading}[Path=fonts/,
  BoldFont=NotoSerifCJKsc-SemiBold.otf,
  ItalicFont=NotoSerifCJKsc-SemiBold.otf,
  BoldItalicFont=NotoSerifCJKsc-SemiBold.otf]{NotoSerifCJKsc-SemiBold.otf}
\renewcommand{\headingfont}{\normalfont\rmfamily\bfseries\CJKfamily{zhheading}}
% coverfont, mathematical fonts, counters, labels and body fonts stay intact.
\ExplSyntaxOn
\box_new:N \l__ch_reference_box
\box_new:N \l__ch_content_box
\dim_new:N \l__ch_shift_dim
\dim_new:N \l__ch_number_shift_dim
\tl_new:N \l__ch_reference_font_tl
\bool_new:N \l__ch_first_bool
\bool_new:N \l__ch_chinese_head_bool
\prg_new_protected_conditional:Npnn \__ch_cjk_name:n #1 { TF }
  {
    \regex_match:nnTF { \A [\x{3400}-\x{9FFF}\x{F900}-\x{FAFF}]+ \Z } {#1}
      { \prg_return_true: } { \prg_return_false: }
  }
\cs_new_protected:Npn \__ch_measure:nn #1#2
  {
    \hbox_set:Nn \l__ch_reference_box { {#1 设} }
    \hbox_set:Nn \l__ch_content_box {#2}
    \dim_set:Nn \l__ch_shift_dim
      { ( \box_ht:N \l__ch_reference_box - \box_dp:N \l__ch_reference_box
        - \box_ht:N \l__ch_content_box + \box_dp:N \l__ch_content_box ) / 2 }
  }
\cs_new_protected:Npn \__ch_raise:nn #1#2
  { \raisebox{#1}[\height][\depth]{#2} }
\cs_new_protected:Npn \__ch_name:nn #1#2
  {
    \__ch_cjk_name:nTF {#2}
      {
        \group_begin:
        \__ch_measure:nn {#1}{#2}
        \bool_set_true:N \l__ch_first_bool
        \tl_map_inline:nn {#2}
          {
            \bool_if:NTF \l__ch_first_bool
              { \bool_set_false:N \l__ch_first_bool } { \CJKglue }
            \__ch_raise:nn {\dim_use:N\l__ch_shift_dim}{##1}
          }
        \group_end:
      }
      {#2}
  }
\cs_new_protected:Npn \__ch_box:nn #1#2
  {
    \group_begin:
    \__ch_measure:nn {#1}{#2}
    \__ch_raise:nn {\dim_use:N\l__ch_shift_dim}{#2}
    \group_end:
  }
\cs_new_protected:Npn \__ch_head:nnnn #1#2#3#4
  {
    \__ch_cjk_name:nTF {#2}
      {
        \bool_set_true:N \l__ch_chinese_head_bool
        \tl_set:Nn \l__ch_reference_font_tl {#1}
        \tl_if_blank:nTF {#3}
          { \__ch_measure:nn {#1}{0} } { \__ch_measure:nn {#1}{#3} }
        \dim_set_eq:NN \l__ch_number_shift_dim \l__ch_shift_dim
        \CHOriginalTheoremHead
          {\__ch_name:nn {#1}{#2}}
          {\__ch_raise:nn {\dim_use:N\l__ch_number_shift_dim}{#3}}{#4}
      }
      {
        \bool_set_false:N \l__ch_chinese_head_bool
        \CHOriginalTheoremHead{#2}{#3}{#4}
      }
  }
\NewDocumentCommand{\ChineseStatementHead}{mmm}
  { \__ch_head:nnnn {\theoremfont}{#1}{#2}{#3} }
\NewDocumentCommand{\ChinesePlainStatementHead}{mmm}
  { \__ch_head:nnnn {\normalfont\songfont}{#1}{#2}{#3} }
\NewDocumentCommand{\ChineseHeadingName}{m}
  { \__ch_name:nn {\theoremfont}{#1} }
\NewDocumentCommand{\ChinesePlainHeadingName}{m}
  { \__ch_name:nn {\normalfont\songfont}{#1} }
% Proof labels already occupy a fixed item-label box. Keep mixed labels such
% as 证明（\autoref{...}）whole; token-wise mapping would break macro arguments.
\NewDocumentCommand{\ChineseProofName}{m}
  { \__ch_box:nn {\normalfont\songfont}{#1} }
\NewDocumentCommand{\ChineseHeadingPunctuation}{m}
  {
    \bool_if:NTF \l__ch_chinese_head_bool
      {
        \regex_match:nnTF { \A [\x{0000}-\x{007F}]+ \Z } {#1}
          { \__ch_raise:nn {\dim_use:N\l__ch_number_shift_dim}{#1} }
          { \__ch_box:nn {\tl_use:N\l__ch_reference_font_tl}{#1} }
      }
      {#1}
  }
\ExplSyntaxOff
\newtheoremstyle{portable-statement}{6pt}{6pt}{\theoremfont}{0pt}
  {\headingfont}{\ChineseHeadingPunctuation{：}}{0.5em}
  {\ChineseStatementHead{#1}{#2}{#3}}
\newtheoremstyle{portable-example}{6pt}{6pt}{\normalfont\songfont}{0pt}
  {\headingfont}{\ChineseHeadingPunctuation{：}}{0.5em}
  {\ChinesePlainStatementHead{#1}{#2}{#3}}
\newtheoremstyle{portable-note}{6pt}{6pt}{\normalfont\songfont}{0pt}
  {\headingfont}{\ChineseHeadingPunctuation{：}}{0.5em}
  {\ChinesePlainStatementHead{#1}{#2}{#3}}
\else
\newcommand{\ChineseStatementHead}[3]{\CHOriginalTheoremHead{#1}{#2}{#3}}
\newcommand{\ChinesePlainStatementHead}[3]{\CHOriginalTheoremHead{#1}{#2}{#3}}
\newcommand{\ChineseHeadingName}[1]{#1}
\newcommand{\ChinesePlainHeadingName}[1]{#1}
\newcommand{\ChineseProofName}[1]{#1}
\newcommand{\ChineseHeadingPunctuation}[1]{#1}
\fi
